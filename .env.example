# Database (Neon or Supabase Postgres). Use the pooled URL for DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth: generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Encrypts Ghana Card / passport numbers and ID photos. 64 hex chars: `openssl rand -hex 32`
ENCRYPTION_KEY=""

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Product photo storage (Vercel project > Storage > Blob). Optional locally: files go to public/uploads.
BLOB_READ_WRITE_TOKEN=""

# Email (https://resend.com). Use a verified domain sender in production.
RESEND_API_KEY=""
EMAIL_FROM="Fuguaa <orders@yourdomain.com>"

# SMS (https://sms.arkesel.com, Ghana). Sender ID max 11 characters.
ARKESEL_API_KEY=""
SMS_SENDER_ID="Fuguaa"

# Admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@fuguaa.com"
ADMIN_PASSWORD="change-me-please"
ADMIN_PHONE="+233200000000"

# Protects the daily maintenance job (auto-releases old shipped orders). openssl rand -hex 16
CRON_SECRET=""
